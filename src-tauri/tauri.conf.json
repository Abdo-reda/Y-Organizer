{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Y Organizer",
	"version": "0.10.0",
	"identifier": "com.nopoint.y",
	"plugins": {
		"sql": {
			"preload": ["sqlite:y.db"]
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NEFCQjY5QjE2OTY3M0MKUldROFoybXhhYnRLTmJLc1FVZDYxQ0liY1BCNVpFdmNjNHBla3pNKzArcnE1YnA1S2drWGpjRkgK",
			"endpoints": ["https://github.com/Abdo-reda/Y-Organizer/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "y",
				"width": 1366,
				"height": 768,
				"minWidth": 640,
        		"minHeight": 360, 
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"zoomHotkeysEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
        "macOS": {
            "signingIdentity": "-"
        },
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
